rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isSmallFile() {
      return request.resource.size < 10 * 1024 * 1024; // Max 10MB
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin'
      );
    }

    // 1. User Avatars & Profile Photos
    // Public read; write strictly restricted to the owning user or admin
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if (isOwner(userId) || isAdmin()) && isImage() && isSmallFile();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 2. Post Images & Community Feed Uploads
    // Public read; write restricted to authenticated owner or admin
    match /posts/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if (isOwner(userId) || isAdmin()) && isImage() && isSmallFile();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 3. Citizen Grievances & Crime Reports Attachments
    // Read restricted to reporting user or admin; write restricted to reporting user
    match /grievances/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) || isAdmin()) && isImage() && isSmallFile();
      allow update, delete: if isAdmin();
    }

    // 4. Sponsored Advertisements & Banners
    // Public read; write restricted strictly to admins
    match /sponsored/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && isSmallFile();
    }

    // 5. Admin & System Branding Assets
    match /admin/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isSmallFile();
    }

    // Default Fallback: Deny all other unlisted paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

